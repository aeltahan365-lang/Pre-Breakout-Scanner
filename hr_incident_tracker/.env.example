# Copy this file to .env in the directory you run the app from (repo root)
# and fill in real values — or just export these as real environment
# variables instead.

# Public URL the app is reachable at — used to build links inside emails.
HR_APP_BASE_URL=http://localhost:8000

# Database. Defaults to a local SQLite file if unset — fine for a single
# always-on server. Use a real Postgres URL for production, and REQUIRED if
# you also want the GitHub Actions reminder cron to see live data.
# HR_DATABASE_URL=postgresql://user:password@host:5432/hr_incidents

# SMTP — leave HR_SMTP_HOST unset to run in dry-run mode (emails are logged,
# not sent), which is useful while you're first trying the app out.
HR_SMTP_HOST=smtp.gmail.com
HR_SMTP_PORT=587
HR_SMTP_USERNAME=your-account@gmail.com
HR_SMTP_PASSWORD=your-app-password
HR_SMTP_FROM=hr-incidents@yourcompany.com
HR_SMTP_USE_TLS=true

# CC'd whenever a case is auto-escalated for missing reminders.
HR_ESCALATION_EMAIL=hr-manager@yourcompany.com

# HR dashboard login (HTTP Basic Auth). Comma-separated user:password pairs.
HR_ADMIN_CREDENTIALS=admin:changeme

# Reminder/escalation tuning (all optional, shown here at their defaults).
# HR_REMINDER_BASE_INTERVAL_HOURS=24
# HR_ESCALATION_THRESHOLD=3
# HR_REMINDER_CHECK_INTERVAL_MINUTES=60
